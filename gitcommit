#!/bin/bash

# ===== ① 自動add（安全寄り） =====
git add -A

# 変更がないなら終了
if [ -z "$(git diff --cached)" ]; then
  echo "No changes to commit."
  exit 0
fi

# ===== ② diff取得（軽量） =====
DIFF=$(git diff --cached | sed 's/\r//g')

# ===== ③ プロンプト =====
PROMPT="あなたはコミットメッセージを生成するアシスタントです。

変更内容に基づいて、3つの異なるコミットメッセージを生成してください。

ルール：
- 各メッセージは1行で書くこと
- 形式: <絵文字> <type>: <メッセージ>
- メッセージは簡潔な日本語で書くこと
- type は次のいずれかにする: feat, fix, chore, docs, refactor
- 絵文字の対応:
  feat -> ✨
  fix -> 🐛
  chore -> 🔧
  docs -> 📝
  refactor -> ♻️
- 差分（diff）をそのまま書かないこと
- 3つのメッセージはそれぞれ異なる書き方にすること

変更内容:
$DIFF
"

# ===== ④ LLM呼び出し（安全JSON） =====
RESP=$(jq -n \
  --arg prompt "$PROMPT" \
  '{
    prompt: $prompt,
    n_predict: 100,
    temperature: 0.8
  }' | curl -s http://localhost:8080/completion \
  -H "Content-Type: application/json" \
  -d @-)

# ===== ⑤ 候補抽出 =====
CANDIDATES=$(echo "$RESP" | jq -r '.content // empty' \
  | sed '/^$/d' \
  | grep -Eo '(✨|🐛|🔧|📝|♻️) (feat|fix|chore|docs|refactor): .+')

# ===== ⑥ フォールバック =====
if [ -z "$CANDIDATES" ]; then
  CANDIDATES="🔧 chore: update files"
fi

# ===== ⑦ 候補表示 =====
echo "===== Commit Message Candidates ====="
i=1
while IFS= read -r line; do
  echo "[$i] $line"
  i=$((i+1))
done <<< "$CANDIDATES"

# ===== ⑧ 選択 =====
echo ""
read -p "Select number (or press Enter to abort): " choice

if [ -z "$choice" ]; then
  echo "Aborted."
  exit 0
fi

MSG=$(echo "$CANDIDATES" | sed -n "${choice}p")

# ===== ⑨ 最終確認 =====
echo ""
echo "Selected:"
echo "$MSG"
read -p "Commit with this message? (y/n): " confirm

if [ "$confirm" != "y" ]; then
  echo "Aborted."
  exit 0
fi

# ===== ⑩ コミット =====
git commit -m "$MSG"
